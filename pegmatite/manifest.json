{
  "manifest_version": 3,
  "name": "PlantUML In-Place Preview",
  "version": "2.0.5",
  "description": "Renders PlantUML code blocks in place, entirely in your browser.",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://github.com/*",
    "https://gist.github.com/*",
    "https://gitpitch.com/*",
    "https://gitlab.com/*",
    "https://bitbucket.org/*",
    "https://*.backlog.jp/wiki/*",
    "https://*/gitbucket/*",
    "https://*/gitlab/*",
    "http://*/gitbucket/*",
    "http://*/gitlab/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "renderer.html",
        "renderer.js",
        "vendor/plantuml.js",
        "vendor/viz-global.js"
      ],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "content_scripts": [
    {
      "js": ["content-script.js"],
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*",
        "https://gitpitch.com/*",
        "https://gitlab.com/*",
        "https://bitbucket.org/*",
        "https://*.backlog.jp/wiki/*",
        "https://*/gitbucket/*",
        "https://*/gitlab/*",
        "http://*/gitbucket/*",
        "http://*/gitlab/*"
      ]
    }
  ]
}
