{
	"env": {
		"browser": true
	},
	"parserOptions": {
		"ecmaVersion": 2017
	},
	"extends": "eslint:recommended",
	"rules": {
		"indent": [
			"error",
			"tab"
		],
		"linebreak-style": [
			"error",
			"unix"
		],
		"quotes": [
			"error",
			"double"
		],
		"semi": [
			"error",
			"always"
		]
	},
	"overrides": [
		{
			"files": ["pegmatite/renderer.js"],
			"parserOptions": {
				"sourceType": "module"
			}
		},
		{
			"files": ["tools/*.js"],
			"env": {
				"node": true
			},
			"rules": {
				"no-console": "off"
			}
		}
	]
}
